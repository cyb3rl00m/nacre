#!/usr/bin/python3 -I
"""Nacre privileged helper.

This small, self-contained program does the jobs that may need root rights:
scanning protected files, updating the ClamAV signature database and
managing the quarantine. The GUI starts it through pkexec, so the user is
asked for their password by the desktop's own polkit dialog.

It never accepts raw clamscan/freshclam arguments: every command line it
runs is built here from a small set of validated options.

Commands
  scan        Run clamscan and relay its output line by line
              (--quarantine-found: quarantine detections when it's done).
  update      Run freshclam (pausing the clamav-freshclam service if needed).
  quarantine  Move infected files into the quarantine (JSON list on stdin).
  restore     Put quarantined files back where they came from.
  delete      Permanently delete quarantined files.
  delete-file Permanently delete files in place (JSON list on stdin).

Results of the file commands are printed as one JSON object per line.
"""

import argparse
import datetime
import fcntl
import hashlib
import json
import os
import pwd
import shutil
import signal
import stat
import subprocess
import sys
import threading
import uuid

SAFE_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# NACRE_STATE_DIR / NACRE_CLAMSCAN / NACRE_FRESHCLAM exist only for the
# test-suite. pkexec wipes the environment, so they can never be injected
# into a privileged run.
STATE_DIR = os.environ.get("NACRE_STATE_DIR", "/var/lib/nacre")
QUARANTINE_DIR = os.path.join(STATE_DIR, "quarantine")
INDEX_FILE = os.path.join(STATE_DIR, "quarantine.json")
LOCK_FILE = os.path.join(STATE_DIR, ".lock")

# Quarantined files are stored XOR-obfuscated so they can't be run, opened
# or picked up by other scanners by accident.
XOR_KEY = b"Nacre quarantine - do not run this file"
CHUNK = 1024 * 1024

# Lines the GUI should read as quarantine results during a scan.
RESULT_PREFIX = "@@NACRE-QUARANTINE "

# Pseudo filesystems and our own quarantine are never scanned.
FULL_SCAN_EXCLUDES = ["/proc", "/sys", "/dev", "/run"]
EXTERNAL_MOUNTS = ["/media", "/mnt"]

os.environ["PATH"] = SAFE_PATH
os.umask(0o022)


# --------------------------------------------------------------------------- utils

def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")


def ere_escape(text):
    """Escape a literal path for a POSIX extended regex (clamscan --exclude-dir)."""
    out = []
    for ch in text:
        if ch in ".^$*+?()[]{}|\\":
            out.append("\\" + ch)
        else:
            out.append(ch)
    return "".join(out)


def dir_regex(path):
    path = path.rstrip("/") or "/"
    return "^" + ere_escape(path) + "($|/)"


def find_tool(env_name, name):
    override = os.environ.get(env_name)
    if override:
        return override
    return shutil.which(name)


# ------------------------------------------------------------------ quarantine index

class Index:
    """Quarantine metadata, stored world-readable so the GUI can list it."""

    def __init__(self):
        os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
        os.makedirs(QUARANTINE_DIR, mode=0o700, exist_ok=True)
        os.chmod(QUARANTINE_DIR, 0o700)
        self._lock = open(LOCK_FILE, "a")
        fcntl.flock(self._lock, fcntl.LOCK_EX)
        try:
            with open(INDEX_FILE, "r", encoding="utf-8") as fh:
                self.items = json.load(fh).get("items", [])
        except (FileNotFoundError, ValueError):
            self.items = []

    def save(self):
        tmp = INDEX_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump({"version": 1, "items": self.items}, fh, indent=1)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, INDEX_FILE)

    def find(self, item_id):
        for item in self.items:
            if item.get("id") == item_id:
                return item
        return None

    def close(self):
        fcntl.flock(self._lock, fcntl.LOCK_UN)
        self._lock.close()


def qfile(item_id):
    # ids are generated by us (uuid4 hex) - refuse anything else
    if not item_id or not all(c in "0123456789abcdef" for c in item_id) or len(item_id) != 32:
        raise ValueError("invalid quarantine id")
    return os.path.join(QUARANTINE_DIR, item_id + ".nqf")


def read_json_stdin():
    raw = sys.stdin.read()
    data = json.loads(raw or "[]")
    if not isinstance(data, list):
        raise ValueError("expected a JSON list on stdin")
    return data


# ------------------------------------------------------------------------- scan

def cmd_scan(args):
    clamscan = find_tool("NACRE_CLAMSCAN", "clamscan")
    if not clamscan:
        print("ERROR: clamscan is not installed (sudo apt install clamav)", flush=True)
        return 2

    paths = list(args.paths)
    if args.full:
        paths = ["/"]
    if not paths:
        print("ERROR: nothing to scan", flush=True)
        return 2
    for p in paths:
        if not os.path.isabs(p):
            print(f"ERROR: not an absolute path: {p}", flush=True)
            return 2

    filesize = max(1, min(4000, args.max_filesize))
    scansize = max(400, min(4000, filesize * 4))

    cmd = [
        clamscan,
        "--recursive=yes",
        "--stdout",
        f"--scan-archive={args.archives}",
        f"--max-filesize={filesize}M",
        f"--max-scansize={scansize}M",
    ]
    if args.pua:
        cmd.append("--detect-pua=yes")

    excludes = [STATE_DIR]
    if args.full:
        excludes += FULL_SCAN_EXCLUDES
        if not args.include_external:
            excludes += EXTERNAL_MOUNTS
    for ex in args.exclude or []:
        if os.path.isabs(ex):
            excludes.append(ex)
    for ex in excludes:
        cmd.append(f"--exclude-dir={dir_regex(ex)}")
    cmd += paths

    # clamscan block-buffers its output when writing to a pipe; stdbuf makes it
    # line-buffered so the progress display stays live.
    if shutil.which("stdbuf"):
        cmd = ["stdbuf", "-oL"] + cmd

    if args.low_priority:
        prefix = []
        if shutil.which("ionice"):
            prefix += ["ionice", "-c", "3"]
        if shutil.which("nice"):
            prefix += ["nice", "-n", "15"]
        cmd = prefix + cmd

    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    state = {"cancelled": False}

    def kill_scan(*_):
        state["cancelled"] = True
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, kill_scan)

    if args.watch_stdin:
        # The GUI cancels a (possibly root-owned) scan by closing our stdin.
        def watch():
            try:
                while sys.stdin.buffer.read(4096):
                    pass
            except (OSError, ValueError):
                pass
            if proc.poll() is None:
                kill_scan()

        threading.Thread(target=watch, daemon=True).start()

    out = sys.stdout.buffer
    found = []
    try:
        for raw in proc.stdout:
            out.write(raw)
            out.flush()
            if args.quarantine_found and raw.rstrip().endswith(b" FOUND"):
                line = raw.rstrip(b"\r\n")[: -len(b" FOUND")].decode("utf-8", "surrogateescape")
                path, sep, sig = line.rpartition(": ")
                if sep and os.path.isabs(path):
                    found.append((path, sig.strip()))
    except BrokenPipeError:
        kill_scan()
    proc.wait()
    if state["cancelled"]:
        return 130
    if found:
        # Quarantine right here, while we still have root rights - no second
        # password prompt (important when nobody is at the computer).
        quarantine_found(found)
    return proc.returncode


def quarantine_found(found):
    index = Index()
    try:
        for path, sig in dict(found).items():
            try:
                item = quarantine_one(index, path, sig)
                result = {"ok": True, "path": path, "id": item["id"]}
            except (OSError, ValueError) as exc:
                result = {"ok": False, "path": path, "error": describe(exc)}
            sys.stdout.write(RESULT_PREFIX + json.dumps(result) + "\n")
            sys.stdout.flush()
    finally:
        index.close()


# ----------------------------------------------------------------------- update

def systemd_active(unit):
    if not shutil.which("systemctl"):
        return False
    res = subprocess.run(["systemctl", "is-active", "--quiet", unit])
    return res.returncode == 0


def cmd_update(_args):
    freshclam = find_tool("NACRE_FRESHCLAM", "freshclam")
    if not freshclam:
        print("ERROR: freshclam is not installed (sudo apt install clamav-freshclam)", flush=True)
        return 2

    unit = "clamav-freshclam"
    was_active = systemd_active(unit)
    if was_active:
        # The background updater holds the database lock; pause it briefly.
        print("Pausing the clamav-freshclam background service…", flush=True)
        subprocess.run(["systemctl", "stop", unit])
    try:
        proc = subprocess.Popen(
            [freshclam, "--stdout"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
        )
        for raw in proc.stdout:
            sys.stdout.buffer.write(raw)
            sys.stdout.flush()
        code = proc.wait()
    finally:
        if was_active:
            print("Restarting the clamav-freshclam background service…", flush=True)
            subprocess.run(["systemctl", "start", unit])
    return code


# ------------------------------------------------------------------- quarantine

def quarantine_one(index, path, signature):
    st = os.lstat(path)
    if not stat.S_ISREG(st.st_mode):
        raise ValueError("not a regular file")
    if os.path.realpath(path).startswith(os.path.realpath(STATE_DIR) + os.sep):
        raise ValueError("file is already in quarantine")

    item_id = uuid.uuid4().hex
    target = qfile(item_id)
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as src:
        out_fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(out_fd, "wb") as dst:
            digest = obfuscate(src, dst)
            dst.flush()
            os.fsync(dst.fileno())
    try:
        os.unlink(path)
    except OSError:
        os.unlink(target)
        raise

    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = str(st.st_uid)

    item = {
        "id": item_id,
        "original_path": path,
        "signature": signature or "Unknown",
        "size": st.st_size,
        "sha256": digest,
        "quarantined_at": now_iso(),
        "mode": stat.S_IMODE(st.st_mode),
        "uid": st.st_uid,
        "gid": st.st_gid,
        "owner": owner,
    }
    index.items.append(item)
    index.save()
    return item


def obfuscate(src, dst):
    """Plain -> obfuscated. Returns sha256 of the plain file."""
    digest = hashlib.sha256()
    offset = 0
    for data in iter(lambda: src.read(CHUNK), b""):
        digest.update(data)
        dst.write(xor_bytes(data, offset))
        offset += len(data)
    return digest.hexdigest()


def deobfuscate(src, dst):
    """Obfuscated -> plain. Returns sha256 of the plain file."""
    digest = hashlib.sha256()
    offset = 0
    for data in iter(lambda: src.read(CHUNK), b""):
        plain = xor_bytes(data, offset)
        digest.update(plain)
        dst.write(plain)
        offset += len(data)
    return digest.hexdigest()


def xor_bytes(data, offset):
    klen = len(XOR_KEY)
    start = offset % klen
    reps = len(data) // klen + 2
    key = (XOR_KEY[start:] + XOR_KEY * reps)[: len(data)]
    n = len(data)
    return (int.from_bytes(data, "little") ^ int.from_bytes(key, "little")).to_bytes(n, "little")


def cmd_quarantine(_args):
    items = read_json_stdin()
    index = Index()
    failed = False
    try:
        for entry in items:
            path = entry.get("path", "") if isinstance(entry, dict) else ""
            sig = entry.get("signature", "") if isinstance(entry, dict) else ""
            try:
                if not os.path.isabs(path):
                    raise ValueError("not an absolute path")
                item = quarantine_one(index, path, sig)
                emit({"ok": True, "path": path, "id": item["id"]})
            except (OSError, ValueError) as exc:
                failed = True
                emit({"ok": False, "path": path, "error": describe(exc)})
    finally:
        index.close()
    return 1 if failed else 0


def restore_target(original):
    if not os.path.lexists(original):
        return original
    base = original + ".restored"
    candidate, n = base, 1
    while os.path.lexists(candidate):
        n += 1
        candidate = f"{base}-{n}"
    return candidate


def cmd_restore(args):
    index = Index()
    failed = False
    try:
        for item_id in args.ids:
            item = index.find(item_id)
            try:
                if not item:
                    raise ValueError("no such quarantined item")
                src_path = qfile(item_id)
                original = item["original_path"]
                parent = os.path.dirname(original)
                if not os.path.isdir(parent):
                    raise ValueError(f"the folder {parent} no longer exists")
                dest = restore_target(original)
                mode = int(item.get("mode", 0o644)) & 0o7777
                out_fd = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
                with open(src_path, "rb") as src, os.fdopen(out_fd, "wb") as dst:
                    digest = deobfuscate(src, dst)
                    dst.flush()
                    os.fsync(dst.fileno())
                try:
                    os.chown(dest, int(item.get("uid", 0)), int(item.get("gid", 0)))
                except OSError:
                    pass  # not root (tests) - keep current owner
                os.chmod(dest, mode)
                if item.get("sha256") and digest != item["sha256"]:
                    os.unlink(dest)
                    raise ValueError("checksum mismatch - quarantined copy is damaged")
                os.unlink(src_path)
                index.items.remove(item)
                index.save()
                emit({"ok": True, "id": item_id, "path": dest})
            except (OSError, ValueError, KeyError) as exc:
                failed = True
                emit({"ok": False, "id": item_id, "error": describe(exc)})
    finally:
        index.close()
    return 1 if failed else 0


def cmd_delete(args):
    index = Index()
    failed = False
    try:
        ids = [i.get("id") for i in index.items] if args.all else args.ids
        for item_id in ids:
            item = index.find(item_id)
            try:
                if not item:
                    raise ValueError("no such quarantined item")
                path = qfile(item_id)
                if os.path.lexists(path):
                    os.unlink(path)
                index.items.remove(item)
                index.save()
                emit({"ok": True, "id": item_id, "path": item.get("original_path")})
            except (OSError, ValueError) as exc:
                failed = True
                emit({"ok": False, "id": item_id, "error": describe(exc)})
        # Remove stray files that have no index entry (e.g. after a crash).
        if args.all:
            known = {i.get("id") for i in index.items}
            for name in os.listdir(QUARANTINE_DIR):
                if name.endswith(".nqf") and name[:-4] not in known:
                    try:
                        os.unlink(os.path.join(QUARANTINE_DIR, name))
                    except OSError:
                        pass
    finally:
        index.close()
    return 1 if failed else 0


def cmd_delete_file(_args):
    items = read_json_stdin()
    failed = False
    for entry in items:
        path = entry.get("path", "") if isinstance(entry, dict) else str(entry)
        try:
            if not os.path.isabs(path):
                raise ValueError("not an absolute path")
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode):
                raise ValueError("not a regular file")
            os.unlink(path)
            emit({"ok": True, "path": path})
        except (OSError, ValueError) as exc:
            failed = True
            emit({"ok": False, "path": path, "error": describe(exc)})
    return 1 if failed else 0


def describe(exc):
    if isinstance(exc, FileNotFoundError):
        return "file no longer exists"
    if isinstance(exc, PermissionError):
        return "permission denied"
    if isinstance(exc, OSError) and exc.strerror:
        return exc.strerror.lower()
    return str(exc)


# ------------------------------------------------------------------------- main

def main(argv):
    parser = argparse.ArgumentParser(prog="nacre-helper")
    sub = parser.add_subparsers(dest="command", required=True)

    scan = sub.add_parser("scan")
    scan.add_argument("--archives", choices=["yes", "no"], default="yes")
    scan.add_argument("--pua", action="store_true")
    scan.add_argument("--max-filesize", type=int, default=100)
    scan.add_argument("--low-priority", action="store_true")
    scan.add_argument("--full", action="store_true")
    scan.add_argument("--include-external", action="store_true")
    scan.add_argument("--exclude", action="append")
    scan.add_argument("--watch-stdin", action="store_true")
    scan.add_argument("--quarantine-found", action="store_true")
    scan.add_argument("paths", nargs="*")

    sub.add_parser("update")
    sub.add_parser("quarantine")

    restore = sub.add_parser("restore")
    restore.add_argument("ids", nargs="+")

    delete = sub.add_parser("delete")
    delete.add_argument("--all", action="store_true")
    delete.add_argument("ids", nargs="*")

    sub.add_parser("delete-file")

    args = parser.parse_args(argv)
    handlers = {
        "scan": cmd_scan,
        "update": cmd_update,
        "quarantine": cmd_quarantine,
        "restore": cmd_restore,
        "delete": cmd_delete,
        "delete-file": cmd_delete_file,
    }
    return handlers[args.command](args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
